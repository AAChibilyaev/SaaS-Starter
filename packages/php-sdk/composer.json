{
  "name": "aacsearch/php-sdk",
  "description": "PHP SDK for AACSearch - Advanced Semantic Search API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "AACSearch Team",
      "email": "support@aacsearch.io"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "AACSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AACSearch\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 src/",
    "lint-fix": "phpcbf --standard=PSR12 src/"
  }
}
